<% content_for :title, "Create a theme — Themery" %>

<article class="guide">
  <p class="hero__eyebrow">the guide</p>
  <h1>create an omarchy theme</h1>
  <p class="guide__lead">A theme is a folder with <strong>two things</strong> in it: a color file and a background image. Everything else is optional polish. This page is the whole journey — from empty folder to published, updating itself forever after.</p>

  <nav class="guide__toc" aria-label="On this page">
    <%= link_to "quickstart", "#quickstart", class: "chip" %>
    <%= link_to "colors.toml", "#colors", class: "chip" %>
    <%= link_to "backgrounds", "#backgrounds", class: "chip" %>
    <%= link_to "test locally", "#test", class: "chip" %>
    <%= link_to "extras", "#extras", class: "chip" %>
    <%= link_to "advanced", "#advanced", class: "chip" %>
    <%= link_to "naming", "#naming", class: "chip" %>
    <%= link_to "publish", "#publish", class: "chip" %>
