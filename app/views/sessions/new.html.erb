<% content_for :title, "Sign in — Themery" %>

<section class="auth">
  <div class="auth__card">
    <p class="hero__eyebrow">welcome back</p>
    <h1 class="auth__title">sign in</h1>

    <%= form_with url: session_path, class: "auth__form" do |form| %>
      <div class="field">
        <%= form.label :email_address, "email" %>
        <%= form.email_field :email_address, required: true, autofocus: true,
              autocomplete: "username", value: params[:email_address] %>
      </div>
      <div class="field">
        <%= form.label :password, "password" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
      </div>
      <%= form.submit "Sign in", class: "auth__submit" %>
    <% end %>

    <p class="auth__alt">
      <%= link_to "forgot password?", new_password_path %>
      <span class="auth__dot">·</span>
      new here? <%= link_to "create an account", new_registration_path %>
    </p>
  </div>
</section>
