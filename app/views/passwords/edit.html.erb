<% content_for :title, "New password — Themery" %>

<section class="auth">
  <div class="auth__card">
    <p class="hero__eyebrow">almost there</p>
    <h1 class="auth__title">choose a new password</h1>

    <%= form_with url: password_path(params[:token]), method: :put, class: "auth__form" do |form| %>
      <div class="field">
        <%= form.label :password, "new password" %>
        <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", maxlength: 72 %>
      </div>
      <div class="field">
        <%= form.label :password_confirmation, "repeat it" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
      </div>
      <%= form.submit "Save new password", class: "auth__submit" %>
    <% end %>
  </div>
</section>
