<%= link_to theme_path(theme.name), class: "card", id: dom_id(theme, :card), data: { turbo_frame: "_top" } do %>
  <%= render "themes/visual", version: theme.latest_version, size: :card %>
  <div class="card__meta">
    <span class="card__name"><%= theme.name %></span>
    <span class="card__mode card__mode--<%= theme.mode %>" title="<%= theme.mode %> theme"></span>
    <% if theme.recently_updated? %>
      <span class="card__updated" title="v<%= theme.latest_version.number %> shipped <%= time_ago_in_words(theme.latest_version.approved_at) %> ago">updated</span>
    <% end %>
    <span class="card__stats">
      <span title="stars">★ <%= theme.stars_count %></span>
      <span title="installs">↓ <%= theme.installs_count %></span>
    </span>
  </div>
<% end %>
