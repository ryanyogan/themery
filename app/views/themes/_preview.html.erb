<%# The Generated Preview: a mock omarchy desktop rendered entirely from the
    theme's parsed colors.toml over its real background. `version` and `size`
    (:card or :hero) are required locals. Every color comes from a --p-*
    custom property, so this one partial is the catalog card, the theme-page
    hero, and (rendered server-side to SVG) the OG share card. %>
<% background = preview_background_url(version, size) %>
<div class="preview preview--<%= size %>" style="<%= preview_style(version.colors) %>">
  <div class="preview__wallpaper" <%= tag.attributes(style: "background-image: url(#{background})") if background %>></div>

  <div class="preview__bar">
    <span class="preview__workspaces">
      <span class="preview__ws preview__ws--active"></span><span class="preview__ws"></span><span class="preview__ws"></span>
    </span>
    <span class="preview__bar-title"><%= version.theme.name %></span>
    <span class="preview__bar-tray">󰖩 󰂯 󰁹</span>
  </div>

  <div class="preview__windows">
    <div class="pwin pwin--terminal">
      <div class="pwin__body">
        <p class="pline"><span class="pline__prompt">❯</span> omarchy-theme-install <%= version.theme.name %></p>
        <p class="pline pline__swatches">
          <span class="sw sw--red"></span><span class="sw sw--orange"></span><span class="sw sw--yellow"></span><span class="sw sw--green"></span><span class="sw sw--cyan"></span><span class="sw sw--blue"></span><span class="sw sw--magenta"></span><span class="sw sw--fg"></span>
        </p>
        <p class="pline"><span class="pline__ok">●</span> theme set to <%= version.theme.name %></p>
        <p class="pline"><span class="pline__prompt">❯</span> ls ~/.config/omarchy</p>
        <p class="pline"><span class="pline__dir">backgrounds</span>  <span class="pline__dir">themes</span>  <span class="pline__file">colors.toml</span></p>
        <p class="pline"><span class="pline__yellow">~</span> <span class="pline__muted">v<%= version.number %> · <%= version.mode %></span></p>
        <p class="pline"><span class="pline__prompt">❯</span><span class="pline__cursor"></span></p>
      </div>
    </div>

    <div class="pwin pwin--editor">
      <div class="pwin__body">
        <% [
          [ "mode", version.mode ],
          [ "accent", version.colors["accent"] ],
          [ "background", version.colors["background"] ],
          [ "foreground", version.colors["foreground"] ],
          [ "green", version.colors["green"] ]
        ].each_with_index do |(key, value), line| %>
          <p class="eline"><span class="eline__num"><%= line + 1 %></span><span class="eline__key"><%= key %></span><span class="eline__eq">=</span><span class="eline__val">"<%= value %>"</span></p>
        <% end %>
      </div>
    </div>
  </div>
</div>
