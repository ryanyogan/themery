<% content_for :title, "#{@theme.name} — Themery" %>
<% content_for :head do %>
  <meta property="og:title" content="<%= @theme.name %> — omarchy theme">
  <meta property="og:description" content="<%= @theme.mode %> theme by <%= @theme.author.username %> · ★ <%= @theme.stars_count %> · <%= @theme.installs_count %> installs. One command to install.">
  <meta property="og:image" content="<%= og_theme_url(@theme.name) %>">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">
<% end %>

<%= turbo_stream_from @theme %>

<article class="theme">
  <div class="theme__hero" data-controller="showcase">
    <div class="showcase__frame">
      <img class="showcase__image" data-showcase-target="image" alt="<%= @theme.name %> in use" hidden>
      <div data-showcase-target="generated">
        <%= render "themes/visual", version: @version, size: :hero %>
      </div>
    </div>

    <% clips = @version.screenshots.to_a + @version.backgrounds.to_a %>
    <% if clips.any? %>
      <div class="clips" role="group" aria-label="Screenshots and wallpapers">
        <button class="clips__thumb clips__thumb--generated is-active"
                data-action="showcase#showGenerated" title="theme preview">
          <%= render "themes/visual", version: @version, size: :card %>
        </button>
        <% @version.screenshots.each do |image| %>
          <button class="clips__thumb"
                  data-action="showcase#show" data-showcase-url-param="<%= url_for(image.variant(:hero)) %>"
                  title="screenshot">
            <img src="<%= url_for(image.variant(:thumb)) %>" alt="" loading="lazy">
          </button>
        <% end %>
        <% @version.backgrounds.each do |image| %>
          <button class="clips__thumb"
                  data-action="showcase#show" data-showcase-url-param="<%= url_for(image.variant(:hero)) %>"
                  title="wallpaper">
            <img src="<%= url_for(image.variant(:thumb)) %>" alt="" loading="lazy">
          </button>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="theme__rail">
    <header class="theme__head">
      <h1 class="theme__name"><%= @theme.name %></h1>
      <p class="theme__byline">
        by <%= link_to @theme.author.username, author_path(@theme.author.username) %>
        · <span class="card__mode card__mode--<%= @theme.mode %>"></span> <%= @theme.mode %>
        · v<%= @version.number %>
      </p>
      <p class="theme__taxonomy">
        <% if @theme.category %><%= link_to @theme.category, themes_path(category: @theme.category), class: "chip" %><% end %>
        <% if @theme.mood %><%= link_to @theme.mood, themes_path(mood: @theme.mood), class: "chip" %><% end %>
      </p>
    </header>

    <%= render "themes/counts", theme: @theme %>

    <button class="install" data-controller="clipboard" data-action="clipboard#copy"
            data-clipboard-copied-class="is-copied" title="Copy the install command">
      <span class="install__label">install with the stock client</span>
      <code class="install__cmd" data-clipboard-target="source"><span class="install__prompt">❯</span> <%= install_command(@theme) %></code>
      <span class="install__hint" data-clipboard-target="hint">click to copy</span>
    </button>

    <div class="theme__actions">
      <%= render "themes/star_button", theme: @theme %>
      <%= button_to "try it on this site", try_theme_path(@theme.name), class: "action action--try" %>
    </div>

    <div class="palette">
      <p class="palette__label">palette</p>
      <div class="palette__row">
        <% %w[background foreground accent red orange yellow green cyan blue magenta selection muted].each do |key| %>
          <% value = @version.colors[key] %>
          <% if value.to_s.match?(ThemesHelper::HEX) %>
            <span class="palette__chip" style="--chip: <%= value %>" title="<%= key %> <%= value %>"></span>
          <% end %>
        <% end %>
      </div>
    </div>

    <section class="versions">
      <p class="versions__label">versions</p>
      <ol class="versions__list">
        <% @versions.each do |version| %>
          <li class="versions__item">
            <span class="versions__tag">v<%= version.number %></span>
            <span class="versions__date"><%= version.approved_at&.to_date %></span>
            <% if version.changelog.present? %>
              <p class="versions__changelog"><%= version.changelog %></p>
            <% end %>
          </li>
        <% end %>
      </ol>
    </section>

    <section class="reviews" id="<%= dom_id(@theme, :reviews) %>">
      <p class="reviews__label">reviews</p>
      <% if @reviews.any? %>
        <% @reviews.each do |review| %>
          <blockquote class="review">
            <p class="review__body"><%= review.body %></p>
            <footer class="review__by">— <%= link_to review.user.username, author_path(review.user.username) %></footer>
          </blockquote>
        <% end %>
      <% else %>
        <p class="reviews__empty">No reviews yet. Installed it? Say how it wears.</p>
      <% end %>

      <% if authenticated? && !@reviews.any? { |review| review.user_id == Current.user.id } %>
        <%= form_with url: theme_reviews_path(@theme.name), scope: :review, class: "reviewform" do |form| %>
          <%= form.text_area :body, rows: 3, placeholder: "One review per person — make it count.", required: true, maxlength: 1000 %>
          <%= form.submit "Post review" %>
        <% end %>
      <% end %>
    </section>
  </div>
</article>
